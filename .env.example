# ==============================================================================
# Environment Configuration for BikeFit Agent (Google ADK)
# Copy this file to .env and configure your values.
# DO NOT commit .env with real secrets to version control.
# ==============================================================================

# Option 1: Google AI Studio (Fastest for testing & local development)
# Get a key from: https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_API_KEY=your_gemini_api_key_here

# Option 2: Google Cloud Agent Platform (Production mode)
# Set GOOGLE_GENAI_USE_VERTEXAI=1 when deploying to Google Cloud Agent Platform
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Google ADK Model Configuration
ADK_DEFAULT_MODEL=gemini-3.8-flash

# Observability & Tracing (OpenTelemetry / Google Cloud Trace)
OTEL_SERVICE_NAME=bikefit-agent
ENABLE_CLOUD_TRACE=false
LOG_LEVEL=INFO

# Local Storage / Session configuration (defaults to in-memory or local sqlite)
# ADK_SESSION_SERVICE_URI=sqlite:///tmp/bikefit_sessions.db
# ADK_ARTIFACT_SERVICE_URI=file:///tmp/bikefit_artifacts
